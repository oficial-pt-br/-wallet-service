{
  "name": "wallet-service",
  "version": "1.0.0",
  "description": "Microserviço de Wallet com garantias de consistência (ACID) e proteção contra race conditions / double spending",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:generate": "prisma generate",
    "test:stress": "k6 run src/tests/stress.js",
    "test:verify": "node src/tests/verify-balances.js"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "express": "^4.19.2",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "prisma": "^5.19.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
